# Copy this file to .streamlit/secrets.toml and add your Supabase
# PostgreSQL connection string. Never publish secrets.toml to GitHub.

[postgres]
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Prefer the Session pooler connection string for Streamlit Cloud.
# Include sslmode=require in the connection string.
url = "postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@HOST:5432/postgres?sslmode=require"
